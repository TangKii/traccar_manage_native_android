<?xml version="1.0" encoding="utf-8"?>
<!-- 沉浸式顶栏（实心渐变）：顶部深蓝 -> 底部品牌蓝。
     由 fitTopBar 撑高到状态栏区域，状态栏与顶栏连成同一块渐变，无横切线。
     13 个列表/表单页默认使用。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/brand_dark"
        android:centerColor="@color/brand"
        android:endColor="@color/brand_top"
        android:type="linear" />
</shape>
