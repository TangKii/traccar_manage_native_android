<?xml version="1.0" encoding="utf-8"?>
<!-- 首页地图专用的半透明沉浸式顶栏（Jiumi 中性石墨，无蓝）：
     顶部为较高不透明度深灰，向下渐变为半透明石墨，让地图从顶栏下方隐约透出。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E61D1D1F"
        android:centerColor="#B36E6E73"
        android:endColor="#4D1D1D1F"
        android:type="linear" />
</shape>
