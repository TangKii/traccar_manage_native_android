<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:contentDescription="@string/desc_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/replay_title"
            android:textColor="@color/brand"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 日期快捷选择 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:layout_margin="12dp"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnToday" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="@string/replay_today" android:textSize="13sp" android:stateListAnimator="@null"
                android:background="@drawable/bg_date_tab" android:textColor="@color/text_date_tab"
                 />
            <Button android:id="@+id/btnYesterday" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="@string/replay_yesterday" android:textSize="13sp" android:stateListAnimator="@null"
                android:background="@drawable/bg_date_tab" android:textColor="@color/text_date_tab"
                 />
            <Button android:id="@+id/btnWeek" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="@string/replay_week" android:textSize="13sp" android:stateListAnimator="@null"
                android:background="@drawable/bg_date_tab" android:textColor="@color/text_date_tab"
                 />
        </LinearLayout>

        <Button android:id="@+id/btnCustom" android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginTop="10dp" android:text="@string/replay_custom" android:textSize="13sp"
            android:stateListAnimator="@null" android:background="@drawable/bg_date_outline"
            android:textColor="@color/brand"  />

        <!-- 自定义时间面板（精确到小时），默认隐藏 -->
        <LinearLayout
            android:id="@+id/customPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="48dp" android:layout_height="wrap_content"
                    android:text="@string/replay_from" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvFrom" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="12dp"
                    android:background="@drawable/bg_input" android:text="@string/replay_from"
                    android:textSize="13sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <TextView android:layout_width="48dp" android:layout_height="wrap_content"
                    android:text="@string/replay_to" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvTo" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="12dp"
                    android:background="@drawable/bg_input" android:text="@string/replay_to"
                    android:textSize="13sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <Button android:id="@+id/btnApply" android:layout_width="match_parent" android:layout_height="42dp"
                android:layout_marginTop="12dp" android:text="@string/replay_apply" android:textSize="14sp"
                android:stateListAnimator="@null" android:background="@drawable/selector_outline_primary"
                android:drawableStart="@drawable/ic_check" android:drawableTint="@color/brand"
                android:drawablePadding="10dp" android:paddingStart="20dp" android:paddingEnd="20dp"
                android:textColor="@color/brand"  />
        </LinearLayout>
    </LinearLayout>

    <!-- 地图 + 悬浮播放控制条：控制条浮在地图底部，不再独占贴底一行，单手更好按 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/mapHolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 悬浮玻璃控制卡：信息 + 进度 + 倍速 + 播放 -->
        <LinearLayout
            android:id="@+id/replayControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_nav_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvReplayInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar android:id="@+id/seekBar" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_gravity="center_vertical" />
                <Button android:id="@+id/btnSpeed" android:layout_width="52dp" android:layout_height="42dp"
                    android:layout_marginStart="8dp" android:background="@drawable/selector_outline_primary"
                    android:text="1x" android:textColor="@color/brand" android:textSize="13sp"
                    android:stateListAnimator="@null" />
                <Button android:id="@+id/btnPlay" android:layout_width="92dp" android:layout_height="42dp"
                    android:layout_marginStart="8dp" android:background="@drawable/selector_outline_primary"
                    android:drawableStart="@drawable/ic_play" android:drawableTint="@color/brand"
                    android:drawablePadding="6dp" android:paddingStart="10dp" android:paddingEnd="8dp"
                    android:text="@string/replay_play" android:textColor="@color/brand" android:textSize="14sp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
