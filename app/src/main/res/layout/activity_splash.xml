<?xml version="1.0" encoding="utf-8"?>
<!-- 品牌开屏：石墨渐变底 + 居中 logo + 应用名 + 底部加载指示。
     对齐 Jiumi 的中性风，无任何蓝色；logo 用 ic_pin（定位针）呼应产品定位。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg"
    android:fitsSystemWindows="true">

    <!-- 居中品牌区 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/splashLogo"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_brand_logo">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pin"
                android:tint="#FFF5F5F7"
                android:contentDescription="@string/desc_locate" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="#FFF5F5F7"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_tagline"
            android:textColor="#B3F5F5F7"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 底部加载指示：细长圆角条 + 环形进度，启动校验时给用户明确反馈 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFF5F5F7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/splash_loading"
            android:textColor="#B3F5F5F7"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
