<?xml version="1.0" encoding="utf-8"?>
<!-- 配色完全对齐 Jiumi（中性灰 + 石墨主色，无蓝色主色）。
     Light: canvas F0F0F3 / card FBFBFC / ink 1D1D1F / inkSecondary 6E6E73
     主按钮与选中态 = 石墨 primary（Jiumi colorScheme.primary = LightInk）。 -->
<resources>
    <color name="brand">#FF1D1D1F</color>          <!-- 主色：石墨（Jiumi primary = LightInk） -->
    <color name="brand_dark">#FF000000</color>     <!-- 按压态更深 -->
    <color name="brand_light">#FFE3E3E8</color>    <!-- 禁用容器（Jiumi LightContainerHigh） -->
    <color name="on_brand">#FFFFFFFF</color>       <!-- 主按钮文字反色（浅色下白字） -->
    <color name="brand_top">#FF6E6E73</color>
    <color name="bg">#FFF0F0F3</color>             <!-- 页面背景（Jiumi LightCanvas） -->
    <color name="surface">#FFFBFBFC</color>        <!-- 卡片（Jiumi LightCard） -->
    <color name="text_primary">#FF1D1D1F</color>   <!-- 主墨色（Jiumi LightInk） -->
    <color name="text_secondary">#FF6E6E73</color> <!-- 次墨色（Jiumi LightInkSecondary） -->
    <color name="divider">#FFE3E3E8</color>        <!-- 分隔线（Jiumi LightContainerHigh） -->
    <color name="online">#FF2FA36B</color>         <!-- Jiumi StatusSuccess -->
    <color name="offline">#FF6E6E73</color>
    <color name="warning">#FFE5900F</color>        <!-- Jiumi StatusWarning -->
    <color name="danger">#FFE5484D</color>         <!-- Jiumi StatusError -->
    <color name="nav_selected">#1A1D1D1F</color>
    <color name="ic_launcher_background">#FF1D1D1F</color>
</resources>
